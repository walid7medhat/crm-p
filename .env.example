APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# URL where the Vue app is opened (password reset emails link here). Defaults to APP_URL if unset.
# FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local (no Redis): database. Production (with Redis): redis — auto-falls back to database if Redis unreachable.
QUEUE_CONNECTION=database

# Use `file` locally so the app works when MySQL is stopped or misconfigured (Laravel 11 reads CACHE_STORE).
CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis works without php-redis extension; use phpredis in production if extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# When true/1, listing publish is blocked if selling price is below 70% of original (contract) price. Default: omit (warn only).
# VITE_LISTING_BLOCK_SUBMIT_SELLING_BELOW_OP=true
# Set to 1 and run `npm run build` to enable HR attendance pipeline debug UI/logs when using Laravel-served assets (not Vite dev).
# VITE_HR_PIPELINE_DEBUG=1

# Meta (Facebook) Integration - optional; token can be provided per-request in the UI
META_APP_ID=
META_APP_SECRET=

# Bitrix24 Integration - inbound webhook URL from Bitrix24 (Developer Resources -> Other -> Inbound webhook).
# Format: https://<portal>.bitrix24.com/rest/<user_id>/<webhook_token>/
BITRIX24_WEBHOOK_URL=
BITRIX24_SYNC_BATCH_SIZE=20
BITRIX24_PAGES_PER_JOB=20
BITRIX24_PROGRESS_REPORT_EVERY=5
BITRIX24_CHAIN_DELAY_SECONDS=2
BITRIX24_INTER_PAGE_DELAY_MS=300
BITRIX24_RATE_LIMIT_RETRY_SECONDS=120
BITRIX24_PARALLEL_SHARDS=1
BITRIX24_SYNC_QUEUE=bitrix24
BITRIX24_FAST_SKIP_EXISTING=true
BITRIX24_DB_INSERT_CHUNK=500
BITRIX24_HTTP_TIMEOUT=60
BITRIX24_API_MAX_RETRIES=5

# Property Finder Enterprise API (leads by webhook + 10-min sync fallback).
# Key/secret from the PF Enterprise dashboard, scopes: leads:read, webhooks:full_access.
# PF_WEBHOOK_SECRET: max 32 chars — generate with: php -r "echo bin2hex(random_bytes(16));"
PF_API_KEY=
PF_API_SECRET=
PF_WEBHOOK_SECRET=
PF_WEBHOOK_URL=
# Leads created in PF before this (UAE time, e.g. 2026-10-05 09:00:00) are never imported.
# Empty = first time the integration runs.
PF_IMPORT_FROM=
PF_SYSTEM_USER_ID=1
# Responsible person by the property's emirate (others → PF_SYSTEM_USER_ID)
PF_DUBAI_USER_ID=59
PF_ABU_DHABI_USER_ID=25

# Shared secrets required by the public /website-lead and /website-lead/wordpress
# lead-intake endpoints. Generate with: php -r "echo bin2hex(random_bytes(24));"
WEBSITE_LEAD_SECRET=
WORDPRESS_LEAD_SECRET=

# No longer used for Web Push eligibility. Safe to leave in place or remove.
# Any active CRM user can subscribe and receive an assignment push.
PUSHER_LEAD_ASSIGNMENT_TEST_MODE=true
PUSHER_LEAD_ASSIGNMENT_TEST_USER_ID=1

# Web Push (server only). Never prefix the private key with VITE_.
# Generate with: php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
WEB_PUSH_VAPID_SUBJECT=mailto:admin@oiaproperties.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Google Cloud Translation API key (used to translate Arabic lead/deal comments)
GOOGLE_TRANSLATE_API_KEY=
# google (production) | mymemory (free, for local testing only)
TRANSLATE_DRIVER=google
